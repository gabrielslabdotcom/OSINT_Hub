# OSINT_Hub — copy to .env and fill in keys you have.
# Collectors without keys are skipped (DNS and crt.sh need none).

# --- Collectors ---
SHODAN_API_KEY=
GITHUB_TOKEN=

# --- LLM (optional; used by `osint-hub analyze` / `osint-hub all --analyze`) ---
# Local: http://127.0.0.1:11434 (no key), OLLAMA_MODEL=llama3.2
# Cloud: https://ollama.com + OLLAMA_API_KEY, model from GET /api/tags (e.g. gemma4:31b)
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gemma4:31b
OLLAMA_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=16384

# --- Optional collectors (skipped if empty) ---
CENSYS_API_TOKEN=
CENSYS_ORGANIZATION_ID=
CENSYS_API_ID=
CENSYS_API_SECRET=
HUNTER_API_KEY=
TOMBA_API_KEY=
TOMBA_SECRET=
# Extra phone lookups for top-ranked mailboxes still missing a number (0 disables).
PEOPLE_PHONE_ENRICH_MAX=5
SECURITYTRAILS_API_KEY=
GREYNOISE_API_KEY=
URLSCAN_API_KEY=
VIRUSTOTAL_API_KEY=
PDCP_API_KEY=
LEAKIX_API_KEY=
HIBP_API_KEY=
ABUSEIPDB_API_KEY=
IPINFO_TOKEN=
